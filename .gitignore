# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed: authnz-rs ships an executable, so CI and the
# production build use the versions cargo deny audited, and a rollback by
# git restores them too. The HTTP/3 smoke client's stays untracked.
tests/h3-smoke-client/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Added by cargo

/target
/.idea
/apple-app-site-association.json
/*.pem

# Production-specific files (deployment configs, secrets, etc.)
*production*

# Editor / OS / tooling noise
.DS_Store
__pycache__/
